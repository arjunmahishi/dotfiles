{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"godoc": {
			"type": "local",
			"command": ["godoc-mcp"],
			"enabled": true
		},
		"gopls": {
			"type": "local",
			"command": ["gopls", "mcp"],
			"enabled": true
		},
		"strava": {
			"type": "local",
			"command": ["npx", "-y", "@r-huijts/strava-mcp-server"],
			"enabled": true
		},
		"Support MCP": {
			"type": "remote",
			"url": "http://localhost:5000/mcp",
			"oauth": {}
		},
		"chrome-devtools": {
			"type": "local",
			"command": ["npx", "-y", "chrome-devtools-mcp"],
			"enabled": true
		}
	},
	"instructions": ["persona/SOUL.md", "persona/STYLE.md"],
	"agent": {},
	"plugin": [
		"@franlol/opencode-md-table-formatter",
		"@mohak34/opencode-notifier@latest"
	],
	"provider": {
		"google-vertex-anthropic": {
			"models": {
				"claude-fable-5": {
					"name": "Claude Fable 5 (Vertex)",
					"reasoning": true,
					"temperature": false,
					"tool_call": true,
					"limit": { "context": 1000000, "output": 128000 }
				}
			}
		},
		"openai": {
			"options": {
				"headerTimeout": 60000,
				"timeout": 600000,
				"chunkTimeout": 60000
			}
		}
	}
}
