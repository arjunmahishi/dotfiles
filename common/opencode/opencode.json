{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"godoc": {
			"type": "local",
			"command": ["godoc-mcp"],
			"enabled": true
		},
		"gopls": {
			"type": "local",
			"command": ["gopls", "mcp"],
			"enabled": true
		},
		"strava": {
			"type": "local",
			"command": ["npx", "-y", "@r-huijts/strava-mcp-server"],
			"enabled": true
		},
		"Support MCP": {
			"type": "remote",
			"url": "http://localhost:5000/mcp",
			"oauth": {}
		},
		"chrome-devtools": {
			"type": "local",
			"command": ["npx", "-y", "chrome-devtools-mcp"],
			"enabled": true
		},
		"strava": {
			"type": "local",
			"command": ["npx", "-y", "@r-huijts/strava-mcp-server"],
			"enabled": true
		},
		"Support MCP": {
			"type": "remote",
			"url": "http://localhost:5000/mcp",
			"oauth": {}
		},
		"playwright": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"@playwright/mcp",
				"--executable-path",
				"/Users/arjunmahishi/Library/Caches/ms-playwright/chromium-1134/chrome-mac/Chromium.app/Contents/MacOS/Chromium"
			],
			"enabled": true
		}
	},
	"permission": {
		"external_directory": {
			"/tmp/**": "allow",
			"/private/tmp/**": "allow",
			"~/plans/**": "allow",
			"~/go/pkg/mod/**": "allow"
		}
	},
	"instructions": [
		"~/.config/opencode/persona/SOUL.md",
		"~/.config/opencode/persona/STYLE.md"
	],
	"default_agent": "plan",
	"agent": {},
	"plugin": [
		"@franlol/opencode-md-table-formatter",
		"@mohak34/opencode-notifier@latest"
	],
	"provider": {
		"google-vertex-anthropic": {
			"models": {
				"claude-fable-5": {
					"name": "Claude Fable 5 (Vertex)",
					"reasoning": true,
					"temperature": false,
					"tool_call": true,
					"limit": { "context": 1000000, "output": 128000 }
				}
			}
		},
		"openai": {
			"options": {
				"headerTimeout": 600000,
				"timeout": 6000000,
				"chunkTimeout": 600000
			}
		}
	}
}
