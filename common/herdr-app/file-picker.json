{
  "query": "",
  "picker": { "width": 0.6, "height": 0.5 },
  "actions": {
    "enter": {
      "argv": ["nvim", "--", "{file}"],
      "destination": "right"
    },
    "ctrl-d": {
      "argv": ["sh", "-c", "jj diff --color=always -- \"$1\" | less -R", "jj-diff", "{file}"],
      "label": "jj diff",
      "destination": "right"
    }
  }
}
